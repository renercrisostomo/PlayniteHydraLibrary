<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Settings Window Header & Notes -->
    <sys:String x:Key="LOCPlayniteHydra_SettingsTitle">Hydra Launcher Library</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_NoAuthNote">Hydra plugin doesn&apos;t require any authentication, it takes library information from Hydra Launcher client&apos;s user data files.</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_TroubleshootingNote">If you are having issues importing games, make sure the Hydra Launcher client is properly installed and your games appear in its library.</sys:String>

    <!-- Behavior Section -->
    <sys:String x:Key="LOCPlayniteHydra_SectionBehavior">Launch and sync options</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_LaunchViaHydraUri">Launch games through Hydra (starts Hydra in the background for Cloud Saves and achievements)</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_RecompProtocolHint">For Recomp games, select the &quot;PC version&quot; when starting the game in Hydra and check &quot;Don&apos;t ask again&quot;.</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_AutoSyncPlaytime">Sync playtime with Hydra automatically</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ImportUninstalled">Also import uninstalled games</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_UpdateExistingOnRefresh">Update covers and icons of already imported games on library refresh</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_BtnRestoreDefaults">Restore defaults</sys:String>

    <!-- Game Play Actions -->
    <sys:String x:Key="LOCPlayniteHydra_ActionPlay">Play</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ActionPlayViaHydra">Play via Hydra (Cloud Save &amp; Achievements)</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ActionLaunchDirectExe">Play direct executable (.exe)</sys:String>

</ResourceDictionary>
