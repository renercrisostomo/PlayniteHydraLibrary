<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Settings Window Header & Notes -->
    <sys:String x:Key="LOCPlayniteHydra_SettingsTitle">Hydra Launcher Library</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_NoAuthNote">Hydra plugin doesn&apos;t require any authentication, it takes library information from Hydra Launcher client&apos;s user data files.</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_TroubleshootingNote">If you are having issues importing games, make sure the Hydra Launcher client is properly installed and your games appear in its library.</sys:String>

    <!-- Behavior Section -->
    <sys:String x:Key="LOCPlayniteHydra_SectionBehavior">Launch and sync options</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_LaunchViaHydraUri">Launch games through Hydra (starts Hydra in the background for Cloud Saves and achievements)</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_AutoSyncPlaytime">Sync playtime with Hydra automatically</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ImportInstalled">Import installed games</sys:String>

    <sys:String x:Key="LOCPlayniteHydra_ImportUninstalled">Import not installed games</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_KeepInstalledIfFilesExist">Keep games marked as installed if their files still exist on disk (even if removed or unlinked in Hydra)</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_UpdateExistingOnRefresh">Update covers and icons of already imported games on library refresh</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_BtnRestoreDefaults">Restore defaults</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_LinkTroubleshooting">Troubleshooting</sys:String>

    <!-- Game Play & Uninstall Actions -->
    <sys:String x:Key="LOCPlayniteHydra_ActionPlay">Play</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ActionPlayViaHydra">Play via Hydra (Cloud Save &amp; Achievements)</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ActionLaunchDirectExe">Play direct executable (.exe)</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ActionUninstall">Uninstall using Hydra client</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_ErrorClientNotFound">Hydra Launcher installation not found.</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_DialogUninstallTitle">Uninstall via Hydra</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_DialogUninstallMessage">To uninstall &quot;{0}&quot;, remove the game files, remove it from your library, or click &quot;Clear&quot; next to the executable path in Hydra. For Recomp games, also remove the PC version under Properties → Discs.</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_DialogUninstallMessageKeepFiles">To uninstall &quot;{0}&quot;, remove the game files in Hydra Launcher (or delete the folder manually). For Recomp games, also remove the PC version under Properties → Discs.</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_DialogBtnOpenHydra">Open Hydra</sys:String>
    <sys:String x:Key="LOCPlayniteHydra_DialogBtnCancel">Cancel</sys:String>

</ResourceDictionary>
